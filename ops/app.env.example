# Copiar para /etc/plataforma-ambiental/app.env; chmod 600; dono root:plataforma.
# Nunca versionar valores reais.
NODE_ENV=production
STAND_RUNTIME_MODE=corporate
PORT=3000
APP_BASE_URL=https://stand.startcampus.pt
DATABASE_URL=mysql://stand_app:ALTERAR@db-vip.interno:3306/stand
JWT_SECRET=GERAR_COM_32_OU_MAIS_CARACTERES_ALEATORIOS
SESSION_ISSUER=stand-environmental-prod

# S3 API do Synology Object Storage/NAS (ou S3 corporativo).
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://nas-objectstore.interno:9000
S3_REGION=eu-west-1
S3_BUCKET=stand-private
S3_ACCESS_KEY_ID=CRIAR_CHAVE_DE_SERVICO
S3_SECRET_ACCESS_KEY=GUARDAR_APENAS_NO_COFRE
S3_FORCE_PATH_STYLE=true

# Valkey dedicado para limites distribuídos e sincronização leve.
VALKEY_URL=rediss://:PASSWORD@valkey-vip.interno:6379/0
ALERT_EMAIL_RECIPIENTS=ambient-alertas@startcampus.pt,operacao-suporte@startcampus.pt

# O mesmo valor é usado no app.env e no scheduler.env; ambos ficam apenas no servidor.
SCHEDULER_TOKEN=GERAR_COM_32_OU_MAIS_CARACTERES_ALEATORIOS

# Serviço de correio corporativo.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=conta-tecnica@startcampus.pt
SMTP_PASS=GUARDAR_APENAS_NO_COFRE
SMTP_FROM=apoioamb@startcampus.pt

# Autodesk Construction Cloud — aplicação técnica própria.
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REDIRECT_URI=https://stand.startcampus.pt/api/autodesk/callback

# BMS fase 2: gateway outbound. A app não liga à rede OT e não envia comandos.
BMS_INGEST_HMAC_SECRET=GERAR_E_GUARDAR_NO_COFRE
BMS_SERVICE_USER_ID=ID_DE_UTILIZADOR_TECNICO
