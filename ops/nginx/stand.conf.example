# /etc/nginx/conf.d/stand.conf
# A zona DMZ termina TLS/WAF. Os destinos abaixo são a rede de serviços, nunca
# expostos diretamente à Internet. Definir IPs/VIPs reais com o IT.
upstream stand_app_nodes {
    least_conn;
    server 10.20.40.14:3000 max_fails=3 fail_timeout=20s;
    server 10.20.40.15:3000 max_fails=3 fail_timeout=20s;
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl http2;
    server_name stand.startcampus.pt;

    # Certificado gerido pela PKI/ACME corporativa; caminhos são exemplos.
    ssl_certificate     /etc/nginx/tls/stand.fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/stand.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 50m;
    server_tokens off;

    # Opcional: incluir regras WAF geridas pela equipa DMZ nesta posição.
    location = /api/health/live { proxy_pass http://stand_app_nodes; access_log off; }
    location = /api/health/ready { proxy_pass http://stand_app_nodes; access_log off; }

    location / {
        proxy_pass http://stand_app_nodes;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}
