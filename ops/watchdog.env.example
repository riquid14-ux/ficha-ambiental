# Copiar para /etc/plataforma-ambiental/watchdog.env com permissões 600.
WATCHDOG_APP_NAME=plataforma-ambiental
WATCHDOG_POLL_SECONDS=30
WATCHDOG_WINDOW_SECONDS=300
WATCHDOG_RESTART_THRESHOLD=3
WATCHDOG_COOLDOWN_SECONDS=1800
WATCHDOG_AUTO_ROLLBACK=true
WATCHDOG_STATE_FILE=/var/lib/plataforma-watchdog/state.json
INCIDENT_ROOT=/var/lib/plataforma-watchdog/incidents
ROLLBACK_SCRIPT=/opt/plataforma-ambiental/current/ops/rollback-to-previous.sh
PM2_HOME=/home/plataforma/.pm2
BACKUP_ROOT=/var/backups/plataforma-ambiental
BACKUP_RETENTION_DAYS=30

# Vários destinatários separados por vírgula. Usar uma lista de distribuição e um suplente.
INCIDENT_EMAIL_RECIPIENTS=responsavel1@startcampus.pt,responsavel2@startcampus.pt
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Token fino/deploy credential apenas com acesso a repository_dispatch no repositório privado.
GITHUB_INCIDENT_REPOSITORY=ORGANIZACAO/REPOSITORIO
GITHUB_INCIDENT_TOKEN=

# Nunca colocar esta informação no Git.
DATABASE_URL=
